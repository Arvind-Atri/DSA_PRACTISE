class Solution {
public:
    int solve(int n, vector<int>& days, vector<int>& costs, int index) {
        if (index >= n)
            return 0;

        // 1 day pass
        int op1 = costs[0] + solve(n, days, costs, index + 1);

        int i;
        // 7 day pass
        for (i = index; i < n and days[i] < days[index] + 7; i++)
            ;

        int op2 = costs[1] + solve(n, days, costs, i);

        // 30 days pass
        for (i = index; i < n and days[i] < days[index] + 30; i++)
            ;
        int op3 = costs[2] + solve(n, days, costs, i);

        return min(op1, min(op2, op3));
    }

    int solveMem(int n, vector<int>& days, vector<int>& costs, int index,
                 vector<int>& dp) {
        if (index >= n)
            return 0;

        if (dp[index] != -1)
            return dp[index];

        // 1 day pass
        int op1 = costs[0] + solveMem(n, days, costs, index + 1, dp);

        int i;
        // 7 day pass
        for (i = index; i < n and days[i] < days[index] + 7; i++)
            ;

        int op2 = costs[1] + solveMem(n, days, costs, i, dp);

        // 30 days pass
        for (i = index; i < n and days[i] < days[index] + 30; i++)
            ;
        int op3 = costs[2] + solveMem(n, days, costs, i, dp);

        return dp[index] = min(op1, min(op2, op3));
    }

    int solveTab(int n, vector<int>& days, vector<int>& costs) {
        vector<int> dp(n + 1, INT_MAX);

        dp[n] = 0;

        for (int k = n - 1; k >= 0; k--) {
            // 1 day pass
            int op1 = costs[0] + dp[ k + 1];

            int i;
            // 7 day pass
            for (i = k; i < n and days[i] < days[k] + 7; i++);
                

            int op2 = costs[1] + dp[i];

            // 30 days pass
            for (i = k; i < n and days[i] < days[k] + 30; i++);
                
            int op3 = costs[2] + dp[ i];

            dp[k] = min(op1, min(op2, op3));
        }
        return dp[0];
    }
    int solveTabSO(vector<int>&days,vector<int>&cost){
        queue<pair<int,int>>monthly;
        queue<pair<int,int>>weekly;
        int ans=0;

        for(int day:days){

            while( !monthly.empty() && monthly.front().first+30<=day){
                monthly.pop();
            }
            while( !weekly.empty() && weekly.front().first+7<=day){
                weekly.pop();
            }

            weekly.push({day,ans+cost[1]});
            monthly.push({day,ans+cost[2]});

        ans=min(ans+cost[0],min(weekly.front().second,monthly.front().second));
        }
        return ans;
    }

    int mincostTickets(vector<int>& days, vector<int>& costs) {
        // vector<int> dp(days.size() + 1, -1);
        // return solveMem(days.size(), days, costs, 0, dp);
        // return solveTab(days.size(), days, costs);
        return solveTabSO( days, costs);

    }
};
